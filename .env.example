# Discord bot token (Developer Portal -> your app -> Bot -> Reset Token)
DISCORD_TOKEN=your-bot-token

# Application (client) ID (Developer Portal -> your app -> General Information)
DISCORD_CLIENT_ID=your-application-id

# Optional: register slash commands INSTANTLY to a single test server.
# Leave empty to register commands globally (can take up to ~1 hour to appear).
DEV_GUILD_ID=

# SQLite database location (relative to the prisma/ directory)
DATABASE_URL="file:./dev.db"
